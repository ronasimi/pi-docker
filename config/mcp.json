{
  "mcpServers": {
    "searxng": {
      "url": "http://mcp-gateway:8888/mcp/",
      "directTools": false,
      "exposeResources": false,
      "requestTimeoutMs": 30000,
      "searchKeywords": {
        "*": ["web", "search", "internet", "searxng", "news", "current", "research"]
      }
    },
    "playwright": {
      "url": "http://mcp-gateway:8931/mcp",
      "directTools": false,
      "exposeResources": false,
      "requestTimeoutMs": 60000,
      "searchKeywords": {
        "*": ["browser", "web", "navigate", "page", "click", "form", "screenshot"]
      }
    },
    "memory": {
      "url": "http://mcp-gateway:8932/mcp",
      "directTools": false,
      "exposeResources": false,
      "requestTimeoutMs": 30000,
      "searchKeywords": {
        "*": ["memory", "remember", "recall", "knowledge", "entity", "relation", "observation"]
      }
    }
  },
  "settings": {
    "directTools": false,
    "namespaceProxyTools": false,
    "allowInstall": false,
    "scriptMode": true,
    "exposeResources": false,
    "hostConfigDiscovery": "off",
    "warnOnLargeDirectTools": true,
    "toolResultRendering": "compact"
  }
}
