{
  "mcpServers": {
    "searxng": {
      "url": "http://mcp-searxng:8888/mcp/",
      "directTools": false,
      "exposeResources": false,
      "requestTimeoutMs": 30000,
      "searchKeywords": {
        "*": [
          "web",
          "search",
          "internet",
          "searxng",
          "news",
          "headlines",
          "latest",
          "current",
          "research",
          "site",
          "url"
        ]
      },
      "lifecycle": "lazy"
    },
    "playwright": {
      "url": "http://mcp-gateway:8931/mcp",
      "directTools": false,
      "exposeResources": false,
      "requestTimeoutMs": 60000,
      "searchKeywords": {
        "browser_navigate": [
          "browse",
          "read",
          "page",
          "website",
          "url",
          "live",
          "headlines",
          "navigate"
        ],
        "browser_snapshot": [
          "read",
          "text",
          "page",
          "snapshot"
        ],
        "browser_take_screenshot": [
          "screenshot",
          "image"
        ]
      },
      "lifecycle": "lazy"
    },
    "memory": {
      "url": "http://mcp-gateway:8932/mcp",
      "directTools": false,
      "exposeResources": false,
      "requestTimeoutMs": 30000,
      "searchKeywords": {
        "*": [
          "memory",
          "remember",
          "recall",
          "knowledge",
          "entity",
          "relation",
          "observation"
        ]
      },
      "lifecycle": "lazy"
    }
  },
  "settings": {
    "directTools": false,
    "namespaceProxyTools": false,
    "allowInstall": false,
    "scriptMode": false,
    "exposeResources": false,
    "hostConfigDiscovery": "off",
    "warnOnLargeDirectTools": true,
    "toolResultRendering": "compact",
    "freezeDirectTools": true,
    "strictDirectToolArguments": true,
    "deferWithMissingMetadata": false,
    "outputGuard": {
      "maxBytes": 12288,
      "maxLines": 300,
      "detailsMaxBytes": 2048
    }
  }
}
