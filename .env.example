# Local browser port for pi-web-ui.
PI_WEB_PORT=8787

# Optional web UI authentication token. Leave blank when binding only to 127.0.0.1.
PI_WEB_TOKEN=


# Tested build pins. The Web UI compatibility check requires these exact versions.
PI_VERSION=1.0.0
PI_WEB_UI_VERSION=0.97.0

# Automatic Ollama model discovery
PI_OLLAMA_CONTEXT_CAP=65536
PI_OLLAMA_MAX_TOKENS=4096
PI_OLLAMA_DISCOVERY_RETRY_SECONDS=30
PI_OLLAMA_HIDE_ALIAS_SOURCES=true

# WhiteRabbitNeo deliberate analysis. V3 uses prompting; native thinking is auto-detected.
PI_WHITERABBIT_REASONING=true
PI_WHITERABBIT_THINKING_LEVEL=medium
