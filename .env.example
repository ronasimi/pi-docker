# Local browser port for pi-web-ui.
PI_WEB_PORT=8787

# Optional web UI authentication token. Leave blank when binding only to 127.0.0.1.
PI_WEB_TOKEN=

# Copy this from ~/Projects/mcp-gateway/.env. scripts/init.sh does this automatically
# when the gateway repo is adjacent to this repo.
MCP_GATEWAY_AUTH_TOKEN=

# Build pins. Change to latest when you intentionally want to update.
PI_VERSION=latest
PI_WEB_UI_VERSION=0.96.1
